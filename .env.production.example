# Configuración de producción.
#
#   cp .env.production.example .env.production
#
# Después reemplazá TODO lo que dice CAMBIAR. El backend se niega a arrancar con
# los secretos de ejemplo puestos, así que si te olvidás de uno te vas a enterar
# al primer `up`, no seis meses después.
#
# Este archivo tiene las contraseñas de la base y la clave que firma las
# sesiones: no va al repo (está en .gitignore) y en el server conviene dejarlo
# en 600.

# ── Dominio y certificado ─────────────────────────────────────────────────────
# El dominio tiene que apuntar (registro A) a la IP del server ANTES del primer
# `up`: Caddy pide el certificado en el arranque y Let's Encrypt valida por HTTP.
APP_DOMAIN=app.tuclub.com.ar
# A esta dirección avisa Let's Encrypt si un certificado no se pudo renovar.
ACME_EMAIL=sistemas@tuclub.com.ar

# Para una prueba en la red interna del club, sin dominio ni certificado:
#   APP_DOMAIN=:80
# Sirve por HTTP plano. Está bien para probar; no para el padrón real.

# ── Base de datos ─────────────────────────────────────────────────────────────
POSTGRES_USER=match_user
POSTGRES_PASSWORD=CAMBIAR-una-contraseña-larga-y-aleatoria
POSTGRES_DB=match_analisis

# Tiene que coincidir con las tres de arriba. El host `db` es el nombre del
# servicio en compose, no se cambia.
DATABASE_URL=postgresql+asyncpg://match_user:CAMBIAR-una-contraseña-larga-y-aleatoria@db:5432/match_analisis

# ── Sesiones ──────────────────────────────────────────────────────────────────
# Generala con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Cambiarla después cierra la sesión de todos a la vez: los tokens viejos dejan
# de validar. No es grave, pero conviene saberlo antes de tocarla un sábado.
SECRET_KEY=CAMBIAR-generar-con-el-comando-de-arriba

ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# ── Primer usuario ────────────────────────────────────────────────────────────
# Se crea solo en el primer arranque si no existe. Es el que crea el club y los
# demás usuarios. Entrá una vez y cambiale la contraseña.
SUPERADMIN_EMAIL=sistemas@tuclub.com.ar
SUPERADMIN_PASSWORD=CAMBIAR-minimo-12-caracteres

# ── CORS ──────────────────────────────────────────────────────────────────────
# Vacío a propósito. El frontend y la API se sirven desde el mismo dominio, así
# que no hay pedido cruzado que permitir. Sólo se completa si algún día la app
# se sirve desde otro dominio que la API.
CORS_ORIGINS=

# ── Backups ───────────────────────────────────────────────────────────────────
# Uno por día, y se guardan los últimos 14. Van a ./backups en el host.
BACKUP_EVERY_SECONDS=86400
BACKUP_KEEP=14

# ── Fotos de jugadores (opcional) ─────────────────────────────────────────────
# Sin esto la app anda; simplemente no se pueden subir fotos.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=sa-east-1
# AWS_S3_BUCKET=
# AWS_S3_PUBLIC_URL=https://cdn.tuclub.com.ar

# ── Notificaciones push (opcional) ────────────────────────────────────────────
# Sin esto la app anda; la bandeja de notificaciones sigue funcionando, sólo
# el push del navegador queda apagado. Son del origen, no del club: se
# generan UNA VEZ para toda la instalación, no una por club.
#   cd backend && python scripts/generate_vapid_keys.py
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@tudominio.com
