# PostgreSQL
POSTGRES_USER=match_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=match_analisis

# Backend
DATABASE_URL=postgresql+asyncpg://match_user:changeme@db:5432/match_analisis
SECRET_KEY=super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Superadmin (creado automaticamente al iniciar el backend si no existe)
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=changeme123

# Frontend (para desarrollo local con vite dev server)
VITE_API_URL=http://localhost:8000

# URL del backend que nginx usa para el proxy (Docker Compose: nombre del servicio)
# En deploys cloud reemplazar con la URL real del backend, ej: https://api.miapp.com
BACKEND_URL=http://backend:8000
