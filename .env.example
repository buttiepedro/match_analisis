# PostgreSQL
POSTGRES_USER=match_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=match_analisis

# Backend
DATABASE_URL=postgresql+asyncpg://match_user:changeme@db:5432/match_analisis
SECRET_KEY=super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Superadmin (creado automaticamente al iniciar el backend si no existe)
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=changeme123

# Frontend (para desarrollo local con vite dev server)
VITE_API_URL=http://localhost:8000

# Proxy del frontend hacia el backend — usar UNA de las dos opciones:
#
# BACKEND_HOST: solo host:puerto (http:// se agrega automaticamente)
#   Ideal para redes internas (Docker Compose, Railway internal DNS)
BACKEND_HOST=backend:8000
#
# BACKEND_URL: URL completa con scheme, tiene precedencia sobre BACKEND_HOST
#   Ideal para backends externos o HTTPS
# BACKEND_URL=https://api.miapp.com
