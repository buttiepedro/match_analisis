# PostgreSQL
POSTGRES_USER=match_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=match_analisis

# Backend
DATABASE_URL=postgresql+asyncpg://match_user:changeme@db:5432/match_analisis
SECRET_KEY=super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Superadmin (creado automaticamente al iniciar el backend si no existe)
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=changeme123

# CORS — origenes permitidos, separados por coma.
# Si queda vacio se acepta cualquier origen y el backend avisa al iniciar.
# En produccion poner la URL del frontend.
CORS_ORIGINS=http://localhost:3000

# Frontend (para desarrollo local con vite dev server)
VITE_API_URL=http://localhost:8000

# AWS S3 — fotos de jugadores
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name
# AWS_S3_PUBLIC_URL=https://cdn.tudominio.com  # opcional: URL de CloudFront u otro CDN

# Notificaciones push (web push) — opcional. Sin configurar, la bandeja de
# notificaciones sigue funcionando; sólo el push del navegador queda apagado.
# Son del origen (esta instalacion), no del club: se generan UNA VEZ, no por
# club. Generarlas con:
#   cd backend && python scripts/generate_vapid_keys.py
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@tudominio.com

# Este archivo es para DESARROLLO. Para poner la app en un servidor, ver
# DEPLOY.md y .env.production.example: ahi el frontend y la API comparten
# dominio detras de Caddy, y no hace falta configurar CORS ni ningun proxy aca.
